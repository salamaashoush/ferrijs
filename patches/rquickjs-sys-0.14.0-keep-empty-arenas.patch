+/* release every empty arena kept for reuse; returns whether any was */
+static bool js_arena_trim(JSRuntime *rt)
+{
+    JSArenaState *s = &rt->arena_state;
+    struct list_head *el, *el1;
+    int i;
+
+    if (s->n_empty_arenas == 0)
+        return false;
+    for (i = 0; i < JS_ARENA_BLOCK_SIZE_COUNT; i++) {
+        list_for_each_safe(el, el1, &s->empty_arena_list[i]) {
+            JSArena *ar = list_entry(el, JSArena, free_link);
+            list_del(&ar->link);
+            rt->mf.js_free(rt->malloc_state.opaque, ar);
+        }
+        init_list_head(&s->empty_arena_list[i]);
+    }
+    s->n_arenas -= s->n_empty_arenas;
+    s->n_empty_arenas = 0;
+    return true;
+}
+
+/* an arena for a size class with no free block: a kept empty one, else a
+   new one */
+static no_inline JSArena *arena_refill(JSRuntime *rt, int block_size_idx)
+{
+    JSArenaState *s = &rt->arena_state;
+    struct list_head *empty = &s->empty_arena_list[block_size_idx];
+    JSArena *ar;
+
+    if (empty->next != empty) {
+        ar = list_entry(empty->next, JSArena, free_link);
+        list_del(&ar->free_link);
+        list_add(&ar->free_link, &s->free_arena_list[block_size_idx]);
+        s->n_empty_arenas--;
+        return ar;
+    }
+    ar = arena_new(rt, block_size_idx);
+    if (!ar && js_arena_trim(rt))
+        ar = arena_new(rt, block_size_idx);
     return ar;
+}
+
+/* Freeing an arena the moment it empties makes a run that allocates past
+   what the realm holds map and unmap arenas every time, and how much the
+   backing allocator then charges depends on unrelated realm contents. An
+   empty arena is kept while empties are fewer than the arenas in use. */
+static no_inline void arena_emptied(JSRuntime *rt, JSArena *ar,
+                                    int block_size_idx)
+{
+    JSArenaState *s = &rt->arena_state;
+
+    list_del(&ar->free_link);
+    if (s->n_empty_arenas * 2 < s->n_arenas) {
+        list_add(&ar->free_link, &s->empty_arena_list[block_size_idx]);
+        s->n_empty_arenas++;
+    } else {
+        list_del(&ar->link);
+        s->n_arenas--;
+        rt->mf.js_free(rt->malloc_state.opaque, ar);
+    }
 }
 
